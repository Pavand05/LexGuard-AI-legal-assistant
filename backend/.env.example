# ─────────────────────────────────────────────────────────────────────────────
# Legal AI Assistant — Backend Environment Variables
# Copy this file to .env and fill in your key(s).
# ─────────────────────────────────────────────────────────────────────────────

# OPTION 1 (Recommended — Free, no credit card):
#   Groq Cloud — https://console.groq.com
#   Free tier: 14,400 requests/day | Models: llama-3.3-70b, mixtral-8x7b, etc.
GROQ_API_KEY=your_groq_api_key_here

# Model to use (leave as-is or change to any free Groq model)
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2 (Alternative — Also free):
#   Google Gemini — https://aistudio.google.com/app/apikey
#   Free tier: 1,500 requests/day | Model: gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
# ─────────────────────────────────────────────────────────────────────────────
